{
  "kind": "collectionType",
  "collectionName": "servicios",
  "info": {
    "singularName": "servicio",
    "pluralName": "servicios",
    "displayName": "Servicio",
    "description": "Definición de servicios dinámicos (ej. Óptica, Dental, etc.)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "descripcion": {
      "type": "text"
    },
    "habilitado": {
      "type": "boolean",
      "default": true
    },
    "email_notificaciones": {
      "type": "email",
      "description": "Correo al que llegarán las solicitudes para este servicio"
    },
    "bloques": {
      "type": "dynamiczone",
      "components": [
        "shared.texto-rico",
        "shared.contenido",
        "shared.alerta"
      ]
    },
    "campos_formulario": {
      "type": "dynamiczone",
      "components": [
        "formulario.campo-texto",
        "formulario.campo-textarea",
        "formulario.campo-numero",
        "formulario.campo-select",
        "formulario.campo-radio",
        "formulario.campo-checkbox",
        "formulario.campo-switch",
        "formulario.campo-fecha",
        "formulario.campo-upload",
        "formulario.campo-mensaje"
      ]
    }
  }
}
