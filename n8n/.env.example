# ============================================================================
# afautal-n8n — Copiar como ".env" (NUNCA versionar .env) y completar.
# ============================================================================

# ---------------------------------------------------------------------------
# INFRAESTRUCTURA (Fase 0)
# ---------------------------------------------------------------------------
# Pin de la imagen. Para producción fijar una versión exacta (ej: 1.100.0).
N8N_IMAGE_VERSION=latest

# Dominio público donde entrará la UI de n8n (lo configuras tú después).
# Ej: n8n.afautal.cl  |  En local: localhost
N8N_DOMAIN=n8n.afautal.cl

# URL ABSOLUTA que los webhooks usan desde afuera (¡crítico, Fase 1!).
# Debe ser accesible desde el VPS de Strapi. Ej: https://n8n.afautal.cl/
N8N_WEBHOOK_URL=https://n8n.afautal.cl/

N8N_HOST=afautal-n8n
N8N_PROTOCOL=https
# Puerto host directo (sin Caddy). Con proxy, no lo necesitas.
N8N_EDITOR_PORT=5678

# Zona horaria de crons y fechas.
GENERIC_TIMEZONE=America/Santiago

# Clave de cifrado de credenciales de n8n. Generar con:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=generar_con_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# BASE DE DATOS interna de n8n (PostgreSQL del compose)
# ---------------------------------------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambiar_me

# ---------------------------------------------------------------------------
# Caddy (solo perfil proxy + dominio público). Let's Encrypt usa N8N_EMAIL.
# ---------------------------------------------------------------------------
N8N_EMAIL=admin@afautal.cl

# ---------------------------------------------------------------------------
# PROYECTO — Strapi (Fase 1)
# ---------------------------------------------------------------------------
# Dominio público de Strapi (el VPS que ya existe en este proyecto).
STRAPI_PUBLIC_URL=https://strapi-afautal.telepyme.cl

# Token de Strapi con permisos de:
#   - Lectura sobre "noticia"
#   - Lectura/creación/actualización sobre "publicacion-red"
# (Crea un token de tipo "Read-only" ampliado, o uno "Full access" interno).
STRAPI_API_TOKEN=tu_token_strapi

# Secret compartido para el header X-AFAUTAL-Token del webhook de Strapi.
# Mismo valor que pondrás en Settings > Webhooks > Headers en Strapi.
STAPI_WEBHOOK_SECRET=genera_uno_largo_con_openssl_rand_base64_24

# Dominio público del frontend (para el enlace de cada noticia en los posts).
# Hoy está en Vercel; cuando cambie a afautal.cl, actualizar aquí.
FRONTEND_URL=https://afautal.vercel.app

# ---------------------------------------------------------------------------
# IA (Fase 2) — provider configurable por env
# ---------------------------------------------------------------------------
# anthropic | openai
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-20250514
AI_API_KEY=sk-ant-...
# Máximo de tokens de salida de la IA.
AI_MAX_TOKENS=2000

# ---------------------------------------------------------------------------
# REDES SOCIALES (Fase 4) — toggle por red, una a la vez
# ---------------------------------------------------------------------------
# Facebook (primera red end-to-end). Token: largo plazo, de tipo Page, desde
# Meta for Developers (> https://developers.facebook.com/tools/explorer/
# para depurar y extender) o short-lived + /me/accounts.
SOCIAL_ENABLED_FACEBOOK=false
FACEBOOK_PAGE_ID=tu_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=pagina_token_largo

# Instagram Business (vía Graph API, cuenta vinculada a la Page de FB).
SOCIAL_ENABLED_INSTAGRAM=false
INSTAGRAM_BUSINESS_ID=tu_ig_business_id
INSTAGRAM_ACCESS_TOKEN=mismo_access_token_con_permiso_instagram

# LinkedIn (página de empresa, no perfil; app aprobada).
SOCIAL_ENABLED_LINKEDIN=false
LINKEDIN_ORGANIZATION_ID=tu_organization_id
LINKEDIN_ACCESS_TOKEN=tu_token

# X / Twitter (API v2; revisa límites/plan según volumen).
SOCIAL_ENABLED_X=false
X_APP_ID=tu_app_id
X_OAUTH_TOKEN=tu_oauth_token

# ---------------------------------------------------------------------------
# NOTIFICACIONES (Fase 3 y 5) — correo al admin
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo_afautal
SMTP_PASS=app_password_o_real
SMTP_FROM=noreply@afautal.cl
# A quién llegan los avisos de aprobación y de errores.
ADMIN_EMAIL=admin@afautal.cl

# ---------------------------------------------------------------------------
# FLUJO (Fase 3) — frecuencia del polling que detecta "aprobado" en Strapi
# ---------------------------------------------------------------------------
APPROVAL_POLL_MINUTES=5