{
  "name": "02 - Aprobación -> Publicación (Facebook)",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Fases 3-4: cada N minutos busca publicacion-red en estado 'aprobado' y publica en las redes habilitadas por env (SOCIAL_ENABLED_*). Facebook es la primera red configurada; Instagram/LinkedIn/X son placeholders desactivados."
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": [
                "0 */5 * * * *"
              ]
            }
          ]
        }
      },
      "id": "9a1c0101-1000-4000-8000-000000000001",
      "name": "01 - Cron (revisar aprobados)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.STRAPI_PUBLIC_URL }}/api/publicaciones-redes?filters%5Bestado%5D%5B%24eq%5D=aprobado&sort=updatedAt%3Aasc&pagination%5BpageSize%5D=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {}
      },
      "id": "9a1c0102-1000-4000-8000-000000000002",
      "name": "02 - GET aprobados (1 item)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "// Gating por env: solo publica si Facebook está habilitado en el .env.\nconst items = ($json.data || []).filter((it) => it && it.estado === 'aprobado');\nconst fbEnabled = String($env.SOCIAL_ENABLED_FACEBOOK || 'false') === 'true';\n\nconst next = fbEnabled && items.length > 0 ? [{ json: { ...items[0] } }] : [];\nreturn [next, []];\n"
      },
      "id": "9a1c0103-1000-4000-8000-000000000003",
      "name": "03 - Destrabar (toggle env)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v21.0/' + $env.FACEBOOK_PAGE_ID + '/photos' }}",
        "sendBody": true,
        "specifyBody": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.texto_facebook }}"
            },
            {
              "name": "url",
              "value": "={{ $json.imagen_portada_url }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.FACEBOOK_PAGE_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "9a1c0104-1000-4000-8000-000000000004",
      "name": "04 - Publicar en Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.STRAPI_PUBLIC_URL }}/api/publicaciones-redes/{{ $json.documentId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ estado: 'publicado', detalle_error: '', redes_publicadas: { facebook: true } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "9a1c0105-1000-4000-8000-000000000005",
      "name": "05 - Marcar publicado en Strapi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $env.ADMIN_EMAIL }}",
        "subject": "Publicado en Facebook: {{ $json.texto_facebook }}",
        "emailFormat": "text",
        "text": "La publicacion en Facebook finalizó correctamente:\n\n{{ $json.texto_facebook }}\n\nImagen: {{ $json.imagen_portada_url }}"
      },
      "id": "9a1c0106-1000-4000-8000-000000000006",
      "name": "06 - Aviso publicación (email)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.2,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.instagram.com/' + $env.INSTAGRAM_BUSINESS_ID + '/media' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "9a1c0107-1000-4000-8000-000000000007",
      "name": "07 - (pending) Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "disabled": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/v2/ugcPosts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "9a1c0108-1000-4000-8000-000000000008",
      "name": "08 - (pending) LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 440],
      "disabled": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.x.com/2/tweets",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "9a1c0109-1000-4000-8000-000000000009",
      "name": "09 - (pending) X/Twitter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 580],
      "disabled": true
    }
  ],
  "connections": {
    "01 - Cron (revisar aprobados)": {
      "main": [
        [
          {
            "node": "02 - GET aprobados (1 item)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "02 - GET aprobados (1 item)": {
      "main": [
        [
          {
            "node": "03 - Destrabar (toggle env)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "03 - Destrabar (toggle env)": {
      "main": [
        [
          {
            "node": "04 - Publicar en Facebook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "04 - Publicar en Facebook": {
      "main": [
        [
          {
            "node": "05 - Marcar publicado en Strapi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "05 - Marcar publicado en Strapi": {
      "main": [
        [
          {
            "node": "06 - Aviso publicación (email)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}